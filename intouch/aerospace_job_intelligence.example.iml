after '+str(1800)+' seconds');rc=124\n    emit('END '+step+' status='+('SUCCESS' if rc==0 else 'FAILED')+' exit_code='+str(rc)+' duration_sec='+str(round(time.monotonic()-t,2)))\n    sys.exit(rc)\nexcept Exception as e:\n    emit('FAILED '+step+' error='+repr(e)+' traceback='+traceback.format_exc().replace('\\n',' | '))\n    sys.exit(1)\n"

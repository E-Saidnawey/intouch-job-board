# Template. Copy to .env (git-ignored) and fill in. Only needed for the Claude
# evaluators (src.claude_evaluator / src.batch_evaluator with --call-api);
# collecting jobs and generating the report need no keys.

# Required for --call-api. Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: override the evaluation model (default: claude-opus-5-5).
# CLAUDE_EVALUATOR_MODEL=
